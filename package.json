{
  "name": "inzly",
  "version": "1.0.0",
  "private": true,
  "description": "AI-powered real estate analysis — product app and data platform",
  "scripts": {
    "dev:app": "npm --prefix frontend run dev",
    "dev:platform": "pnpm --dir backend run dev",
    "build:app": "npm --prefix frontend run build",
    "build:platform": "pnpm --dir backend run build",
    "build": "npm run build:app && npm run build:platform",
    "check:app": "npm --prefix frontend run check",
    "platform:up": "docker compose -f backend/docker-compose.yml up -d",
    "platform:down": "docker compose -f backend/docker-compose.yml down"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT"
}
