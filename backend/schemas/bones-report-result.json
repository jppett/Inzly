{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BonesReportResult",
  "type": "object",
  "required": [
    "id",
    "address_request_id",
    "report_data",
    "created_at",
    "status"
  ],
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "address_request_id": {
      "type": "string",
      "format": "uuid"
    },
    "report_data": {
      "type": "object"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "type": "string",
      "enum": [
        "completed",
        "failed"
      ]
    }
  }
}