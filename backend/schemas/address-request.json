{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AddressRequest",
  "type": "object",
  "required": [
    "id",
    "address",
    "created_at",
    "status"
  ],
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "address": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "processing",
        "processed",
        "failed"
      ]
    }
  }
}