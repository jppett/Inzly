# RentCast Fetcher Service Dockerfile
FROM node:20-alpine

# Set working directory
WORKDIR /app

# Install pnpm
RUN npm install -g pnpm

# Copy package files for dependency resolution
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml ./
COPY packages/shared/package.json ./packages/shared/
COPY packages/rentcast-fetcher/package.json ./packages/rentcast-fetcher/

# Install dependencies
RUN pnpm install --frozen-lockfile

# Copy source code
COPY packages/shared ./packages/shared
COPY packages/rentcast-fetcher ./packages/rentcast-fetcher
COPY tsconfig.json ./

# Build the shared package first
RUN pnpm --filter @bones-report/shared run build

# Build the rentcast-fetcher service
RUN pnpm --filter @bones-report/rentcast-fetcher run build

# Set user for security
USER node

# Start the rentcast-fetcher service
CMD ["node", "packages/rentcast-fetcher/dist/index.js"]