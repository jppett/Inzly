# Environment Variables for Local Development
# Copy this file to .env and customize as needed

# Node.js environment
NODE_ENV=development
LOG_LEVEL=info

# Redpanda/Kafka (automatically set by Docker Compose)
# REDPANDA_BROKERS=redpanda:9092

# Redis (automatically set by Docker Compose)
# REDIS_URL=redis://redis:6379

# API Configuration
PORT=8080

# RentCast API Configuration
# Get your API key from https://rentcast.io
RENTCAST_API_KEY=your-rentcast-api-key-here
RENTCAST_BASE_URL=https://api.rentcast.io

# Photo Analysis (photo-analyst service)
# Expert vision agents that read listing photographs and produce buyer-facing
# findings. Without a key the service uses a deterministic mock, so the whole
# stack still runs end to end with no credentials.
ANTHROPIC_API_KEY=
# anthropic | mock — omit to auto-select based on whether a key is present
VISION_PROVIDER=
VISION_MODEL=claude-opus-5
# low | medium | high | xhigh | max — trades cost against thoroughness
VISION_EFFORT=high

# Permit History (permits-fetcher service)
# Building permits from Shovels, used to corroborate what the photo agents see:
# a roof permitted in 2023 is three years old, whatever the shingles look like.
# Without a key the service uses a real captured permit history as a fixture.
SHOVELS_API_KEY=
SHOVELS_BASE_URL=https://api.shovels.ai/v2
SHOVELS_PERMIT_FROM=2000-01-01

# MLS API Configuration (for future use)
# MLS_API_KEY=your-mls-api-key-here
# MLS_BASE_URL=https://api.mls-provider.com

# Database Configuration (for future migration from Redis)
# DATABASE_URL=postgresql://user:password@localhost:5432/bones_report

# External Service URLs (for production)
# EXTERNAL_REDIS_URL=redis://your-redis-host:6379
# EXTERNAL_KAFKA_BROKERS=your-kafka-host:9092