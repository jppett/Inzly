# ---------------------------------------------------------------------------
# Inzly web app (React client + Express BFF)
# Copy to .env and fill in. Never commit the filled-in copy.
# ---------------------------------------------------------------------------

# --- Server ----------------------------------------------------------------
PORT=5000
NODE_ENV=development

# Postgres. Required for users, sessions, saved homes and AI-generated issues,
# regardless of where property data comes from.
DATABASE_URL=postgresql://user:password@localhost:5432/inzly

# Signs session cookies. Set a long random value in production.
SESSION_SECRET=change-me

# --- Property data connection ----------------------------------------------
# database (default) — read properties from the local Postgres tables
# platform           — read properties from the event-driven services in backend/
INZLY_DATA_SOURCE=database

# Required when INZLY_DATA_SOURCE=platform.
# PLATFORM_API_URL=http://localhost:8080
# PLATFORM_API_KEY=
# PLATFORM_API_TIMEOUT_MS=10000

# --- Browser-side API target -----------------------------------------------
# Which base URL the React app calls. One of: local | platform | mock
# `local` and `platform` both mean "this app's own /api"; the server decides
# the actual source via INZLY_DATA_SOURCE above.
VITE_API_TARGET=mock

# Explicit override; wins over VITE_API_TARGET when set.
# VITE_API_BASE_URL=http://localhost:5000/api

# --- AI ---------------------------------------------------------------------
# Property analysis, chat and image generation.
AI_INTEGRATIONS_OPENAI_API_KEY=
AI_INTEGRATIONS_OPENAI_BASE_URL=
